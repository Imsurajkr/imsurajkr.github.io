---
import ToolLayout from '../../layouts/ToolLayout.astro';
---

<ToolLayout slug="yaml-json">
  <div class="tool-panel">
    <div class="tool-row">
      <div class="tool-field">
        <label for="direction">Direction</label>
        <select id="direction" class="tool-select">
          <option value="y2j">YAML → JSON</option>
          <option value="j2y">JSON → YAML</option>
        </select>
      </div>

      <div class="tool-field">
        <label for="indent">Indent</label>
        <select id="indent" class="tool-select">
          <option value="2" selected>2 spaces</option>
          <option value="4">4 spaces</option>
        </select>
      </div>

      <label class="tool-check sort-check">
        <input type="checkbox" id="sortkeys" /> Sort keys
      </label>

      <button type="button" class="btn btn--sm" id="sample-btn">Sample manifest</button>
      <button type="button" class="btn btn--sm" id="swap-btn">Swap ⇅</button>
    </div>
  </div>

  <div class="tool-grid">
    <div class="tool-panel">
      <p class="tool-panel__title" id="input-label">Input — YAML</p>
      <label class="visually-hidden" for="input">Input document</label>
      <textarea
        id="input"
        class="tool-textarea"
        rows="18"
        spellcheck="false"
        autocomplete="off"
        placeholder="Paste a Kubernetes manifest, CI config or JSON document…"></textarea>
    </div>

    <div class="tool-panel">
      <div class="tool-head-row">
        <p class="tool-panel__title" id="output-label">Output — JSON</p>
        <div class="tool-actions">
          <button type="button" class="btn btn--sm" id="copy-btn">Copy</button>
          <button type="button" class="btn btn--sm" id="download-btn">Download</button>
        </div>
      </div>
      <pre id="output" class="tool-output" data-placeholder="Converted output appears here."></pre>
      <p id="status" class="tool-status" role="status"></p>
    </div>
  </div>

  <div class="tool-panel">
    <p class="tool-panel__title">Notes</p>
    <ul class="notes muted">
      <li>
        Multi-document YAML (separated by <code>---</code>) converts to a JSON array, one entry per
        document — handy for manifests bundled in a single file.
      </li>
      <li>
        YAML comments are not preserved: JSON has no way to represent them, so a round trip drops
        them.
      </li>
      <li>
        Parsing uses safe schema loading — no custom tags are executed.
      </li>
    </ul>
  </div>
</ToolLayout>

<style>
  .sort-check {
    padding-bottom: 0.6rem;
  }

  .notes {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.88rem;
    padding-left: 1.1rem;
  }
</style>

<script>
  import { loadAll, dump, JSON_SCHEMA } from 'js-yaml';

  const input = document.getElementById('input') as HTMLTextAreaElement | null;
  const output = document.getElementById('output') as HTMLPreElement | null;
  const status = document.getElementById('status') as HTMLElement | null;
  const direction = document.getElementById('direction') as HTMLSelectElement | null;
  const indentSelect = document.getElementById('indent') as HTMLSelectElement | null;
  const sortKeys = document.getElementById('sortkeys') as HTMLInputElement | null;

  const SAMPLE_YAML = `apiVersion: apps/v1
kind: Deployment
metadata:
  name: api
  labels:
    app: api
spec:
  replicas: 3
  selector:
    matchLabels:
      app: api
  template:
    metadata:
      labels:
        app: api
    spec:
      containers:
        - name: api
          image: ghcr.io/example/api:1.4.2
          ports:
            - containerPort: 8080
          resources:
            requests:
              cpu: 100m
              memory: 128Mi
            limits:
              cpu: 500m
              memory: 512Mi
`;

  function setStatus(message: string, kind: 'ok' | 'error' | '' = '') {
    if (!status) return;
    status.textContent = message;
    status.className = `tool-status${kind ? ` tool-status--${kind}` : ''}`;
  }

  function updateLabels() {
    const toJson = direction?.value === 'y2j';
    (document.getElementById('input-label') as HTMLElement).textContent =
      `Input — ${toJson ? 'YAML' : 'JSON'}`;
    (document.getElementById('output-label') as HTMLElement).textContent =
      `Output — ${toJson ? 'JSON' : 'YAML'}`;
  }

  function run() {
    if (!input || !output) return;

    const text = input.value.trim();
    if (!text) {
      output.textContent = '';
      setStatus('');
      return;
    }

    const indent = Number(indentSelect?.value ?? 2);
    const sort = sortKeys?.checked ?? false;

    try {
      if (direction?.value === 'y2j') {
        const docs = loadAll(text, null, { schema: JSON_SCHEMA });
        const value = docs.length === 1 ? docs[0] : docs;
        output.textContent = JSON.stringify(sort ? sortValue(value) : value, null, indent);
        setStatus(
          docs.length > 1 ? `Converted ${docs.length} documents to a JSON array.` : 'Converted to JSON.',
          'ok'
        );
      } else {
        const parsed = JSON.parse(text);
        output.textContent = dump(parsed, {
          indent,
          sortKeys: sort,
          lineWidth: 100,
          noRefs: true,
        });
        setStatus('Converted to YAML.', 'ok');
      }
    } catch (error) {
      output.textContent = '';
      const message = error instanceof Error ? error.message : String(error);
      setStatus(message.split('\n')[0], 'error');
    }
  }

  /** Recursively sort object keys so JSON output is stable. */
  function sortValue(value: unknown): unknown {
    if (Array.isArray(value)) return value.map(sortValue);
    if (value && typeof value === 'object') {
      return Object.fromEntries(
        Object.entries(value as Record<string, unknown>)
          .sort(([a], [b]) => a.localeCompare(b))
          .map(([key, val]) => [key, sortValue(val)])
      );
    }
    return value;
  }

  input?.addEventListener('input', run);
  indentSelect?.addEventListener('change', run);
  sortKeys?.addEventListener('change', run);
  direction?.addEventListener('change', () => {
    updateLabels();
    run();
  });

  document.getElementById('sample-btn')?.addEventListener('click', () => {
    if (!input || !direction) return;
    direction.value = 'y2j';
    input.value = SAMPLE_YAML;
    updateLabels();
    run();
  });

  document.getElementById('swap-btn')?.addEventListener('click', () => {
    if (!input || !output || !direction || !output.textContent) return;
    input.value = output.textContent;
    direction.value = direction.value === 'y2j' ? 'j2y' : 'y2j';
    updateLabels();
    run();
  });

  document.getElementById('copy-btn')?.addEventListener('click', async (event) => {
    const button = event.currentTarget as HTMLButtonElement;
    const original = button.textContent;
    try {
      await navigator.clipboard.writeText(output?.textContent ?? '');
      button.textContent = 'Copied ✓';
    } catch {
      button.textContent = 'Copy failed';
    }
    setTimeout(() => {
      button.textContent = original;
    }, 1500);
  });

  document.getElementById('download-btn')?.addEventListener('click', () => {
    const text = output?.textContent ?? '';
    if (!text) return;
    const toJson = direction?.value === 'y2j';
    const blob = new Blob([text], { type: toJson ? 'application/json' : 'text/yaml' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = toJson ? 'converted.json' : 'converted.yaml';
    link.click();
    URL.revokeObjectURL(url);
  });

  updateLabels();
</script>

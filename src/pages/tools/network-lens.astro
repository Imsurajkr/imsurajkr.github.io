---
import { readFileSync } from 'node:fs';
import { createHash } from 'node:crypto';
import ToolLayout from '../../layouts/ToolLayout.astro';

/**
 * Hash the collector at build time. A published checksum that is generated by
 * hand drifts from the file the first time anyone edits it, and a stale
 * checksum is worse than none — it teaches people the check is noise.
 */
const sh = readFileSync('public/netlens.sh');
const ps = readFileSync('public/netlens.ps1');
const hash = (b: Buffer) => createHash('sha256').update(b).digest('hex');

const collectors = [
  {
    id: 'linux',
    label: 'Linux',
    file: 'netlens.sh',
    sha256: hash(sh),
    lines: sh.toString().split('\n').length,
    get: 'curl -fsSLO https://surajkr.dev/netlens.sh && less netlens.sh',
    verify: `echo "${hash(sh)}  netlens.sh" | sha256sum -c`,
    run: 'bash netlens.sh',
    privileged: 'Run with sudo to include firewall and NAT rules.',
    needs: 'Uses iproute2 (ip, ss) and /proc. macOS is not supported — the BSD userland is different enough that shipping it untested would be worse than not shipping it.',
  },
  {
    id: 'windows',
    label: 'Windows',
    file: 'netlens.ps1',
    sha256: hash(ps),
    lines: ps.toString().split('\n').length,
    get: 'iwr https://surajkr.dev/netlens.ps1 -OutFile netlens.ps1; notepad netlens.ps1',
    verify: `(Get-FileHash .\\netlens.ps1 -Algorithm SHA256).Hash -eq "${hash(ps).toUpperCase()}"`,
    run: 'powershell -ExecutionPolicy Bypass -File .\\netlens.ps1',
    privileged: 'Run as Administrator to include firewall and NAT rules.',
    needs: 'Uses the NetTCPIP cmdlets (Get-NetTCPConnection, Get-NetRoute, Get-NetNeighbor).',
  },
];
---

<ToolLayout slug="network-lens">
  <div class="tool-panel">
    <p class="tool-panel__title">1 · Collect on the machine</p>

    <p class="lead-sm">
      The collector is read-only. It runs the operating system's own commands, writes one JSON
      file, makes no network requests and changes nothing. Read it before you run it — that is why
      it ships as a file rather than something you pipe into a shell.
    </p>

    <div class="platforms" role="tablist" aria-label="Choose your platform">
      {
        collectors.map((c, i) => (
          <button
            type="button"
            role="tab"
            class:list={['platform', i === 0 && 'is-active']}
            data-platform={c.id}
            aria-selected={i === 0 ? 'true' : 'false'}
          >
            {c.label}
          </button>
        ))
      }
    </div>

    {
      collectors.map((c, i) => (
        <div class="steps" data-panel={c.id} hidden={i !== 0}>
          <p class="platform__needs">{c.needs}</p>

          <div class="step">
            <span class="step__n">1</span>
            <div>
              <p class="step__label">Download and read it</p>
              <div class="cmd">
                <code>{c.get}</code>
                <button type="button" class="cmd__copy" data-copy={c.get}>copy</button>
              </div>
            </div>
          </div>

          <div class="step">
            <span class="step__n">2</span>
            <div>
              <p class="step__label">
                Check it is the file I published — {c.file}, {c.lines} lines
              </p>
              <div class="cmd">
                <code>{c.verify}</code>
                <button type="button" class="cmd__copy" data-copy={c.verify}>copy</button>
              </div>
            </div>
          </div>

          <div class="step">
            <span class="step__n">3</span>
            <div>
              <p class="step__label">
                Run it — add <code>{c.id === 'windows' ? '-Redact' : '--redact'}</code> if you intend
                to share the report
              </p>
              <div class="cmd">
                <code>{c.run}</code>
                <button type="button" class="cmd__copy" data-copy={c.run}>copy</button>
              </div>
              <p class="step__note">
                {c.privileged} Without that it still works and tells you what it could not see.
              </p>
            </div>
          </div>
        </div>
      ))
    }
  </div>

  <div class="tool-panel">
    <div class="tool-head-row">
      <p class="tool-panel__title">2 · Open the report here</p>
      <div class="tool-actions">
        <button type="button" class="btn btn--sm" id="sample-btn">Load a sample</button>
        <button type="button" class="btn btn--sm" id="clear-btn">Clear</button>
      </div>
    </div>

    <label class="drop" id="drop" for="file">
      <input id="file" class="visually-hidden" type="file" accept=".json,application/json" />
      <svg viewBox="0 0 24 24" aria-hidden="true" class="drop__icon">
        <path d="M12 16V4m0 0L8 8m4-4 4 4"></path>
        <path d="M4 15v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3"></path>
      </svg>
      <span class="drop__main">Drop <code>netlens-report.json</code> here</span>
      <span class="drop__sub">or click to choose — the file is read in this tab and never uploaded</span>
    </label>

    <p class="or">or paste it</p>

    <label class="visually-hidden" for="paste">Paste the JSON report</label>
    <textarea
      id="paste"
      class="tool-textarea"
      rows="5"
      spellcheck="false"
      autocomplete="off"
      placeholder="Paste the contents of netlens-report.json — useful when you are on a remote box and would rather not copy a file back."
    ></textarea>

    <p id="status" class="tool-status" role="status"></p>
  </div>

  <div id="results" hidden>
    <div class="tool-panel" id="summary-panel">
      <div class="tool-head-row">
        <p class="tool-panel__title">The machine</p>
        <div class="tool-actions">
          <span class="chip" id="redact-badge" hidden>redacted</span>
          <button type="button" class="btn btn--sm" id="copy-summary">Copy summary</button>
        </div>
      </div>
      <dl class="kv" id="host-facts"></dl>
    </div>

    <div class="tool-panel">
      <p class="tool-panel__title">How this machine connects</p>
      <p class="caption dim">
        Built from the default route, the interface carrying it, what is listening, and the
        connections that were actually open when the report ran.
      </p>
      <div class="map-wrap">
        <svg id="map" viewBox="0 0 960 560" role="img" aria-label="How this machine connects"></svg>
      </div>
    </div>

    <div class="tool-panel">
      <p class="tool-panel__title">Who could reach this machine</p>
      <p class="caption dim">
        Listening sockets grouped by what they are bound to. A local snapshot cannot prove what a
        firewall elsewhere allows, so this is exposure as the host sees it — not a reachability test.
      </p>
      <div id="exposure"></div>
    </div>

    <div class="tool-panel">
      <p class="tool-panel__title">What this machine can reach</p>
      <p class="caption dim">
        A route existing is not proof of reachability. Anything marked <em>observed</em> had a live
        connection or a resolved neighbour at collection time; everything else is only what the
        routing table claims.
      </p>
      <div class="scroll-x">
        <table class="tool-table">
          <thead>
            <tr><th>Destination</th><th>Via</th><th>Device</th><th>Evidence</th></tr>
          </thead>
          <tbody id="reach-body"></tbody>
        </table>
      </div>
    </div>

    <div class="tool-panel" id="conn-panel">
      <div class="tool-head-row">
        <p class="tool-panel__title">Open connections</p>
        <p class="count dim" id="conn-count"></p>
      </div>
      <div class="scroll-x">
        <table class="tool-table">
          <thead>
            <tr><th>Process</th><th>Local</th><th>Peer</th><th>Port</th><th>Scope</th></tr>
          </thead>
          <tbody id="conn-body"></tbody>
        </table>
      </div>
    </div>

    <div class="tool-panel" id="iface-panel">
      <p class="tool-panel__title">Interfaces and neighbours</p>
      <div class="tool-grid">
        <div class="scroll-x">
          <table class="tool-table">
            <thead><tr><th>Interface</th><th>State</th><th>Addresses</th><th>MTU</th></tr></thead>
            <tbody id="iface-body"></tbody>
          </table>
        </div>
        <div class="scroll-x">
          <table class="tool-table">
            <thead><tr><th>Neighbour</th><th>Device</th><th>State</th></tr></thead>
            <tbody id="neigh-body"></tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="tool-panel" id="obs-panel">
      <p class="tool-panel__title">Observations</p>
      <p class="caption dim">
        Things worth a second look — not vulnerabilities. Whether any of them is a problem depends
        on what this machine is for, which the report cannot know.
      </p>
      <ul class="findings" id="observations"></ul>
    </div>

    <div class="tool-panel" id="cap-panel">
      <p class="tool-panel__title">What the collector could see</p>
      <p class="caption dim">
        An incomplete report that looks complete is the dangerous kind, so this is stated plainly.
      </p>
      <div class="caps" id="caps"></div>
      <ul class="notes notes--tight" id="notes"></ul>
    </div>
  </div>

  <div class="tool-panel notes-panel">
    <p class="tool-panel__title">What this is and is not</p>
    <ul class="notes">
      <li>
        <strong>It correlates evidence the machine already has.</strong> Linux knows its interfaces,
        routes, neighbours, sockets and sessions. Nothing here is discovered by probing the network —
        no scan is performed, and no packet is sent.
      </li>
      <li>
        <strong>It cannot prove external reachability.</strong> A listener bound to
        <code>0.0.0.0</code> is reachable from any network this host sits on, but a security group,
        a cloud ACL or an upstream firewall may still block it. That evidence is not on this machine.
      </li>
      <li>
        <strong>Without root it sees less.</strong> Firewall rules, NAT counters and the process
        behind a socket owned by another user all need privilege. The report records what it missed
        rather than quietly omitting it.
      </li>
      <li>
        <strong>Treat the report as sensitive.</strong> It contains internal addressing, hostnames,
        listening services and the source addresses of live sessions. Use
        <code>--redact</code> before putting one in a ticket.
      </li>
    </ul>
  </div>

  <noscript>
    <p class="tool-status tool-status--error">
      This viewer needs JavaScript — it parses the report entirely in your browser.
    </p>
  </noscript>
</ToolLayout>

<style>
  .lead-sm {
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--fg-2);
    max-width: 74ch;
    margin-bottom: 1.1rem;
  }

  .platforms {
    display: flex;
    gap: 0.3rem;
    margin-bottom: 1.1rem;
    border-bottom: 1px solid var(--line);
  }

  .platform {
    background: none;
    border: 0;
    border-bottom: 2px solid transparent;
    padding: 0.45rem 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--fg-3);
    cursor: pointer;
    margin-bottom: -1px;
  }

  .platform:hover {
    color: var(--fg);
  }

  .platform.is-active {
    color: var(--signal);
    border-bottom-color: var(--signal);
  }

  .platform__needs {
    font-size: 0.8rem;
    color: var(--fg-3);
    margin-bottom: 0.3rem;
  }

  .steps {
    display: grid;
    gap: 0.9rem;
  }

  /* An author-level `display` beats the user agent's `[hidden] { display: none }`,
     so without this the non-selected platforms stay on screen. */
  .steps[hidden] {
    display: none;
  }

  .step {
    display: grid;
    grid-template-columns: 1.5rem 1fr;
    gap: 0.75rem;
    align-items: start;
  }

  .step__n {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--signal);
    border: 1px solid var(--line-2);
    border-radius: 3px;
    text-align: center;
    line-height: 1.45;
  }

  .step__label {
    font-size: 0.85rem;
    color: var(--fg-2);
    margin-bottom: 0.35rem;
  }

  .step__note {
    font-size: 0.78rem;
    color: var(--fg-3);
    margin-top: 0.35rem;
  }

  .cmd {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    padding: 0.5rem 0.65rem;
  }

  .cmd code {
    flex: 1;
    font-size: 0.8rem;
    line-height: 1.5;
    word-break: break-all;
    color: var(--fg);
  }

  .cmd__copy {
    flex: none;
    background: none;
    border: 0;
    color: var(--fg-4);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    cursor: pointer;
    padding: 0.1rem 0.3rem;
    border-radius: 3px;
  }

  .cmd__copy:hover {
    color: var(--signal);
    background: var(--signal-soft);
  }

  .drop {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    text-align: center;
    padding: clamp(1.4rem, 4vw, 2.2rem) 1rem;
    border: 1px dashed var(--line-2);
    border-radius: var(--r);
    background: var(--bg);
    cursor: pointer;
    transition: border-color 0.18s var(--ease), background 0.18s var(--ease);
  }

  .drop:hover,
  .drop.is-over {
    border-color: var(--signal);
    background: var(--signal-soft);
  }

  .drop__icon {
    width: 1.5rem;
    height: 1.5rem;
    fill: none;
    stroke: var(--signal);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .drop__main {
    font-weight: 550;
    color: var(--fg);
    font-size: 0.92rem;
  }

  .drop__sub {
    font-size: 0.78rem;
    color: var(--fg-3);
  }

  .or {
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--fg-4);
    margin: 0.8rem 0 0.5rem;
  }

  .caption {
    font-size: 0.8rem;
    line-height: 1.55;
    margin-bottom: 0.9rem;
    max-width: 78ch;
  }

  .dim {
    color: var(--fg-3);
  }

  .count {
    font-family: var(--font-mono);
    font-size: 0.76rem;
  }

  .map-wrap {
    border: 1px solid var(--line);
    border-radius: var(--r);
    background: var(--bg);
    padding: 0.5rem;
    overflow-x: auto;
  }

  .map-wrap svg {
    display: block;
    width: 100%;
    min-width: 34rem;
    height: auto;
  }

  .exposure-group {
    border: 1px solid var(--line);
    border-radius: var(--r);
    margin-bottom: 0.7rem;
    overflow: hidden;
  }

  .exposure-group__head {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    padding: 0.6rem 0.85rem;
    background: var(--bg-2);
    border-bottom: 1px solid var(--line);
    font-size: 0.85rem;
  }

  .exposure-group__head strong {
    color: var(--fg);
  }

  .exposure-group__note {
    font-size: 0.76rem;
    color: var(--fg-3);
    margin-left: auto;
    text-align: right;
  }

  .port-row {
    display: grid;
    grid-template-columns: 7rem 1fr auto;
    gap: 0.75rem;
    padding: 0.45rem 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    border-bottom: 1px solid var(--line);
  }

  .port-row:last-child {
    border-bottom: 0;
  }

  .port-row__svc {
    color: var(--fg-3);
    font-family: var(--font-sans);
    font-size: 0.8rem;
  }

  .caps {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    margin-bottom: 0.9rem;
  }

  .cap {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--fg-3);
  }

  .cap.is-on {
    color: var(--health);
  }

  .cap.is-off {
    color: var(--fg-4);
  }

  .findings {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
  }

  .findings li {
    display: grid;
    grid-template-columns: 0.45rem 1fr;
    gap: 0.75rem;
    font-size: 0.86rem;
    color: var(--fg-2);
    line-height: 1.55;
  }

  .findings li::before {
    content: '';
    border-radius: 2px;
    background: var(--line-3);
  }

  .findings li.is-warn::before { background: var(--guard); }
  .findings li.is-info::before { background: var(--signal); }
  .findings li.is-good::before { background: var(--health); }

  .findings strong {
    display: block;
    color: var(--fg);
    font-weight: 600;
    margin-bottom: 0.15rem;
  }

  .notes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.8rem;
    font-size: 0.86rem;
    color: var(--fg-2);
    line-height: 1.6;
  }

  .notes--tight {
    gap: 0.45rem;
    font-size: 0.8rem;
    color: var(--fg-3);
  }

  .notes strong {
    color: var(--fg);
    font-weight: 600;
  }

  .notes-panel {
    margin-top: 1rem;
  }

  .tool-table .mono {
    font-family: var(--font-mono);
  }

  .tag {
    display: inline-block;
    font-size: 0.68rem;
    padding: 0.05rem 0.35rem;
    border-radius: 3px;
    border: 1px solid var(--line-2);
    color: var(--fg-3);
  }

  .tag--observed {
    color: var(--health);
    border-color: color-mix(in oklab, var(--health) 45%, transparent);
    background: var(--health-soft);
  }

  .tag--claimed {
    color: var(--fg-4);
  }
</style>

<script>
  // ==========================================================================
  // Network Lens viewer.
  //
  // Reads the JSON the collector produced and turns it into a picture. The
  // report never leaves the tab — there is no upload path in this file.
  // ==========================================================================

  interface Report {
    netlens?: { version?: string; generated?: string; redacted?: boolean };
    host?: Record<string, string | number>;
    capabilities?: Record<string, boolean>;
    interfaces?: {
      name: string;
      state: string;
      mtu: number;
      mac: string;
      addresses: { address: string; prefix: number; family: string; scope: string }[];
    }[];
    routes?: {
      destination: string;
      via: string;
      device: string;
      protocol: string;
      metric: number;
      default: boolean;
    }[];
    neighbors?: { address: string; device: string; mac: string; state: string }[];
    listeners?: {
      protocol: string;
      address: string;
      port: number;
      scope: string;
      process: string;
      pid: number;
    }[];
    connections?: {
      state: string;
      local_address: string;
      local_port: number;
      remote_address: string;
      remote_port: number;
      process: string;
      pid: number;
    }[];
    firewall?: Record<string, boolean | number | string>;
    sessions?: { user: string; tty: string; from: string; since: string; remote: boolean }[];
    dns?: { servers: string[]; search: string[] };
    notes?: string[];
  }

  const SERVICES: Record<number, string> = {
    21: 'FTP', 22: 'SSH', 23: 'Telnet', 25: 'SMTP', 53: 'DNS', 67: 'DHCP', 80: 'HTTP',
    110: 'POP3', 123: 'NTP', 143: 'IMAP', 161: 'SNMP', 389: 'LDAP', 443: 'HTTPS',
    445: 'SMB', 465: 'SMTPS', 514: 'Syslog', 587: 'SMTP', 636: 'LDAPS', 993: 'IMAPS',
    1433: 'MSSQL', 2049: 'NFS', 2379: 'etcd', 3306: 'MySQL', 3389: 'RDP', 5432: 'PostgreSQL',
    5672: 'AMQP', 6379: 'Redis', 6443: 'Kubernetes API', 8080: 'HTTP-alt', 8443: 'HTTPS-alt',
    9090: 'Prometheus', 9092: 'Kafka', 9200: 'Elasticsearch', 11211: 'Memcached',
    27017: 'MongoDB', 5353: 'mDNS',
  };

  /** Services that should almost never face an untrusted network. */
  const SENSITIVE = new Set([
    23, 445, 1433, 2049, 2379, 3306, 3389, 5432, 6379, 9200, 11211, 27017, 5672, 9092,
  ]);

  const svcName = (port: number, proto: string) => SERVICES[port] ?? `${proto}/${port}`;

  const isPrivate = (ip: string) =>
    /^10\./.test(ip) ||
    /^127\./.test(ip) ||
    /^169\.254\./.test(ip) ||
    /^192\.168\./.test(ip) ||
    /^172\.(1[6-9]|2\d|3[01])\./.test(ip) ||
    /^100\.(6[4-9]|[7-9]\d|1[01]\d|12[0-7])\./.test(ip) ||
    ip === '::1' ||
    /^f[cd]/i.test(ip) ||
    /^fe80/i.test(ip);

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;

  const esc = (s: string) =>
    String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  const SVG_NS = 'http://www.w3.org/2000/svg';

  const results = $('results');
  const status = $('status');
  const pasteBox = $<HTMLTextAreaElement>('paste');
  const fileInput = $<HTMLInputElement>('file');
  const drop = $<HTMLLabelElement>('drop');

  let summaryText = '';

  function setStatus(message: string, kind: '' | 'error' | 'ok' = '') {
    if (!status) return;
    status.textContent = message;
    status.className = `tool-status${kind ? ` tool-status--${kind}` : ''}`;
  }

  // ------------------------------------------------------------------ facts

  function renderHost(r: Report) {
    const h = r.host ?? {};
    const caps = r.capabilities ?? {};
    const up = Number(h.uptime_seconds ?? 0);
    const days = Math.floor(up / 86400);
    const hours = Math.floor((up % 86400) / 3600);

    const rows: [string, string][] = [
      ['Hostname', String(h.hostname ?? '—')],
      ['Platform', String(h.os_family ?? 'linux')],
      ['OS', String(h.os ?? '—')],
      ['Kernel', `${h.kernel ?? '—'} · ${h.arch ?? ''}`],
      ['Virtualisation', String(h.virtualisation ?? '—')],
      ['Uptime', up ? `${days}d ${hours}h` : '—'],
      ['Report taken', String(r.netlens?.generated ?? '—')],
      ['Collected as', caps.root ? 'root' : 'unprivileged user'],
      [
        'DNS',
        (r.dns?.servers ?? []).join(', ') +
          ((r.dns?.search ?? []).length ? ` (search: ${(r.dns!.search ?? []).join(' ')})` : ''),
      ],
    ];

    const facts = $('host-facts');
    if (facts) {
      facts.innerHTML = rows
        .map(([k, v]) => `<div><dt>${esc(k)}</dt><dd>${esc(v || '—')}</dd></div>`)
        .join('');
    }

    const badge = $('redact-badge');
    if (badge) badge.hidden = !r.netlens?.redacted;
  }

  // -------------------------------------------------------------------- map

  function renderMap(r: Report) {
    const svg = document.getElementById('map') as SVGSVGElement | null;
    if (!svg) return;
    svg.textContent = '';

    const W = 960;
    const routes = r.routes ?? [];
    const def = routes.find((x) => x.default);
    const listeners = r.listeners ?? [];
    const conns = r.connections ?? [];

    // The interface that carries the default route is the one the story runs
    // through; without a default route there is no internet leg to draw.
    const primaryIface = (r.interfaces ?? []).find((i) => i.name === def?.device);
    const primaryAddr = primaryIface?.addresses.find((a) => a.family === 'inet' && a.scope === 'global');

    const exposed = listeners
      .filter((l) => l.scope === 'all-interfaces')
      .sort((a, b) => a.port - b.port);
    const localOnly = listeners.filter((l) => l.scope === 'loopback');

    // Group outbound connections by peer so one busy peer is one node.
    const peers = new Map<string, { addr: string; ports: Set<number>; procs: Set<string>; n: number }>();
    for (const c of conns) {
      if (!c.remote_address || c.remote_address === '127.0.0.1') continue;
      let p = peers.get(c.remote_address);
      if (!p) peers.set(c.remote_address, (p = { addr: c.remote_address, ports: new Set(), procs: new Set(), n: 0 }));
      p.ports.add(c.remote_port);
      if (c.process) p.procs.add(c.process);
      p.n++;
    }
    const peerList = [...peers.values()].sort((a, b) => b.n - a.n).slice(0, 6);

    const node = (x: number, y: number, w: number, h: number, title: string, sub: string, kind: string) => {
      const g = document.createElementNS(SVG_NS, 'g');
      const rect = document.createElementNS(SVG_NS, 'rect');
      rect.setAttribute('x', String(x - w / 2));
      rect.setAttribute('y', String(y - h / 2));
      rect.setAttribute('width', String(w));
      rect.setAttribute('height', String(h));
      rect.setAttribute('rx', '6');
      rect.setAttribute('class', `nl-node nl-node--${kind}`);
      g.appendChild(rect);

      const t1 = document.createElementNS(SVG_NS, 'text');
      t1.setAttribute('x', String(x));
      t1.setAttribute('y', String(y + (sub ? -2 : 4)));
      t1.setAttribute('text-anchor', 'middle');
      t1.setAttribute('class', 'nl-label');
      t1.textContent = title;
      g.appendChild(t1);

      if (sub) {
        const t2 = document.createElementNS(SVG_NS, 'text');
        t2.setAttribute('x', String(x));
        t2.setAttribute('y', String(y + 13));
        t2.setAttribute('text-anchor', 'middle');
        t2.setAttribute('class', 'nl-sub');
        t2.textContent = sub;
        g.appendChild(t2);
      }
      svg.appendChild(g);
    };

    const link = (x1: number, y1: number, x2: number, y2: number, kind = '') => {
      const path = document.createElementNS(SVG_NS, 'path');
      const my = (y1 + y2) / 2;
      path.setAttribute('d', `M${x1} ${y1} C${x1} ${my} ${x2} ${my} ${x2} ${y2}`);
      path.setAttribute('class', `nl-link ${kind}`);
      svg.appendChild(path);
    };

    const cx = W / 2;
    let y = 42;

    if (def) {
      node(cx, y, 150, 34, 'Internet', '', 'cloud');
      link(cx, y + 17, cx, y + 55);
      y += 72;
      node(cx, y, 190, 40, def.via || 'gateway', `default via ${def.device}`, 'gw');
      link(cx, y + 20, cx, y + 58);
      y += 76;
    } else {
      node(cx, y, 260, 34, 'No default route', 'this host has no path off-net', 'warn');
      y += 72;
    }

    const ifaceY = y;
    node(
      cx,
      ifaceY,
      240,
      44,
      primaryIface?.name ?? (r.interfaces ?? [])[0]?.name ?? 'interface',
      primaryAddr ? `${primaryAddr.address}/${primaryAddr.prefix}` : '',
      'iface',
    );

    // Listeners on the left, outbound peers on the right.
    const rowY = ifaceY + 110;
    const colGap = 150;

    const drawColumn = (items: string[][], startX: number, kind: string) => {
      items.forEach((it, i) => {
        const ny = rowY + i * 46;
        const nx = startX;
        link(cx, ifaceY + 22, nx, ny - 15, kind === 'peer' ? 'nl-link--out' : '');
        node(nx, ny, 240, 34, it[0], it[1], kind);
      });
    };

    const leftItems = exposed
      .slice(0, 6)
      .map((l) => [`:${l.port} ${svcName(l.port, l.protocol)}`, l.process || 'process unknown']);
    const rightItems = peerList.map((p) => [
      p.addr,
      `${[...p.ports].slice(0, 3).map((x) => `:${x}`).join(' ')}${p.n > 1 ? ` · ${p.n} conns` : ''}`,
    ]);

    if (leftItems.length) drawColumn(leftItems, cx - colGap - 130, 'listen');
    if (rightItems.length) drawColumn(rightItems, cx + colGap + 130, 'peer');

    const headings = [
      leftItems.length ? [cx - colGap - 130, 'ACCEPTING'] : null,
      rightItems.length ? [cx + colGap + 130, 'TALKING TO'] : null,
    ].filter(Boolean) as [number, string][];

    for (const [hx, text] of headings) {
      const t = document.createElementNS(SVG_NS, 'text');
      t.setAttribute('x', String(hx));
      t.setAttribute('y', String(rowY - 38));
      t.setAttribute('text-anchor', 'middle');
      t.setAttribute('class', 'nl-heading');
      t.textContent = text;
      svg.appendChild(t);
    }

    if (localOnly.length) {
      const t = document.createElementNS(SVG_NS, 'text');
      t.setAttribute('x', String(cx));
      t.setAttribute('y', String(rowY + Math.max(leftItems.length, rightItems.length) * 46 + 6));
      t.setAttribute('text-anchor', 'middle');
      t.setAttribute('class', 'nl-sub');
      t.textContent = `${localOnly.length} more listening on loopback only — not reachable from the network`;
      svg.appendChild(t);
    }

    const rows = Math.max(leftItems.length, rightItems.length, 1);
    svg.setAttribute('viewBox', `0 0 ${W} ${rowY + rows * 46 + 40}`);
  }

  // --------------------------------------------------------------- exposure

  function renderExposure(r: Report) {
    const box = $('exposure');
    if (!box) return;

    const listeners = r.listeners ?? [];
    const groups: [string, string, string][] = [
      ['all-interfaces', 'Bound to every interface', 'Reachable from any network this host is attached to, subject to firewalls elsewhere.'],
      ['specific', 'Bound to one address', 'Reachable only via that address.'],
      ['loopback', 'Loopback only', 'Not reachable from the network at all.'],
    ];

    box.innerHTML = groups
      .map(([scope, title, note]) => {
        const items = listeners.filter((l) => l.scope === scope).sort((a, b) => a.port - b.port);
        if (!items.length) return '';
        return `<div class="exposure-group">
            <div class="exposure-group__head">
              <strong>${esc(title)}</strong>
              <span class="tag">${items.length}</span>
              <span class="exposure-group__note">${esc(note)}</span>
            </div>
            ${items
              .map(
                (l) => `<div class="port-row">
                  <span>${esc(l.address)}:${l.port}</span>
                  <span class="port-row__svc">${esc(svcName(l.port, l.protocol))}${
                    l.process ? ` · ${esc(l.process)}` : ''
                  }</span>
                  <span>${
                    scope === 'all-interfaces' && SENSITIVE.has(l.port)
                      ? '<span class="tag" style="color:var(--guard);border-color:var(--guard)">sensitive</span>'
                      : ''
                  }</span>
                </div>`,
              )
              .join('')}
          </div>`;
      })
      .join('');
  }

  // ------------------------------------------------------------ reachability

  function renderReach(r: Report) {
    const body = $('reach-body');
    if (!body) return;

    const conns = r.connections ?? [];
    const neigh = r.neighbors ?? [];

    // Only a live connection or a resolved neighbour counts as observed. A
    // route is a claim about intent, not evidence of a working path.
    const observedNets = new Set<string>();
    for (const c of conns) if (c.remote_address) observedNets.add(c.remote_address);
    for (const n of neigh) if (n.state === 'REACHABLE') observedNets.add(n.address);

    const inRoute = (addr: string, dest: string) => {
      if (dest === 'default') return true;
      const [net, bits] = dest.split('/');
      if (!bits) return addr === net;
      const toInt = (ip: string) =>
        ip.split('.').reduce((acc, o) => (acc << 8) + (Number(o) & 255), 0) >>> 0;
      if (!/^\d+\.\d+\.\d+\.\d+$/.test(addr) || !/^\d+\.\d+\.\d+\.\d+$/.test(net)) return false;
      const mask = Number(bits) === 0 ? 0 : (0xffffffff << (32 - Number(bits))) >>> 0;
      return (toInt(addr) & mask) === (toInt(net) & mask);
    };

    body.innerHTML = (r.routes ?? [])
      .map((route) => {
        const evidence = [...observedNets].filter((a) => inRoute(a, route.destination));
        const observed = evidence.length > 0;
        return `<tr>
            <td class="mono">${esc(route.destination)}</td>
            <td class="mono">${esc(route.via || 'directly connected')}</td>
            <td class="mono">${esc(route.device)}</td>
            <td>${
              observed
                ? `<span class="tag tag--observed">observed</span> <span class="dim">${evidence.length} peer${
                    evidence.length === 1 ? '' : 's'
                  }</span>`
                : '<span class="tag tag--claimed">route exists</span>'
            }</td>
          </tr>`;
      })
      .join('');
  }

  // ------------------------------------------------------------- other tables

  function renderTables(r: Report) {
    const conns = (r.connections ?? []).slice().sort((a, b) => a.remote_port - b.remote_port);
    const cbody = $('conn-body');
    if (cbody) {
      cbody.innerHTML = conns
        .slice(0, 60)
        .map(
          (c) => `<tr>
            <td>${esc(c.process || '—')}</td>
            <td class="mono">${esc(c.local_address)}:${c.local_port}</td>
            <td class="mono">${esc(c.remote_address)}</td>
            <td class="mono">${c.remote_port} <span class="dim">${esc(
              SERVICES[c.remote_port] ?? '',
            )}</span></td>
            <td>${isPrivate(c.remote_address) ? '<span class="tag">internal</span>' : '<span class="tag" style="color:var(--signal)">external</span>'}</td>
          </tr>`,
        )
        .join('');
    }
    const ccount = $('conn-count');
    if (ccount) ccount.textContent = `${conns.length} established${conns.length > 60 ? ', showing 60' : ''}`;

    const ibody = $('iface-body');
    if (ibody) {
      ibody.innerHTML = (r.interfaces ?? [])
        .map(
          (i) => `<tr>
            <td class="mono">${esc(i.name)}</td>
            <td>${esc(i.state)}</td>
            <td class="mono">${
              i.addresses.map((a) => `${esc(a.address)}/${a.prefix}`).join('<br>') || '—'
            }</td>
            <td class="mono">${i.mtu || '—'}</td>
          </tr>`,
        )
        .join('');
    }

    const nbody = $('neigh-body');
    if (nbody) {
      nbody.innerHTML = (r.neighbors ?? [])
        .map(
          (n) => `<tr>
            <td class="mono">${esc(n.address)}</td>
            <td class="mono">${esc(n.device)}</td>
            <td>${
              n.state === 'REACHABLE'
                ? '<span class="tag tag--observed">REACHABLE</span>'
                : `<span class="tag">${esc(n.state)}</span>`
            }</td>
          </tr>`,
        )
        .join('');
    }
  }

  // ----------------------------------------------------------- observations

  function renderObservations(r: Report) {
    const out: { level: string; title: string; detail: string }[] = [];
    const listeners = r.listeners ?? [];
    const conns = r.connections ?? [];
    const fw = r.firewall ?? {};

    const exposed = listeners.filter((l) => l.scope === 'all-interfaces');
    const sensitive = exposed.filter((l) => SENSITIVE.has(l.port));

    if (sensitive.length) {
      out.push({
        level: 'warn',
        title: `${sensitive.length} sensitive service${sensitive.length === 1 ? '' : 's'} bound to every interface`,
        detail: `${sensitive
          .map((l) => `${svcName(l.port, l.protocol)} on :${l.port}`)
          .join(', ')}. Databases and admin services are usually meant to be reachable from a specific network, not from wherever this host happens to be attached. Whether that is a problem depends on what sits in front of it.`,
      });
    }

    const ssh = exposed.find((l) => l.port === 22);
    if (ssh) {
      out.push({
        level: 'warn',
        title: 'SSH is listening on every interface',
        detail:
          'Normal for a server reached over a management network, and worth a look on a host with a public address. Binding it to the management address, or restricting it upstream, narrows the exposure.',
      });
    }

    const loopback = listeners.filter((l) => l.scope === 'loopback');
    if (loopback.length) {
      out.push({
        level: 'good',
        title: `${loopback.length} service${loopback.length === 1 ? '' : 's'} bound to loopback only`,
        detail: `${loopback
          .slice(0, 5)
          .map((l) => svcName(l.port, l.protocol))
          .join(', ')}${loopback.length > 5 ? ' and others' : ''} cannot be reached from the network at all. That is the safe default and worth keeping.`,
      });
    }

    if (fw.ip_forwarding === true) {
      out.push({
        level: 'info',
        title: 'IP forwarding is enabled',
        detail:
          'This machine will route packets between its interfaces. Expected on a router, a NAT gateway or a container host — unexpected on an ordinary application server.',
      });
    }

    const nat = Number(fw.snat_rules ?? 0) + Number(fw.dnat_rules ?? 0) + Number(fw.masquerade_rules ?? 0);
    if (nat > 0) {
      out.push({
        level: 'info',
        title: `${nat} NAT rule${nat === 1 ? '' : 's'} in place`,
        detail: `${fw.snat_rules ?? 0} SNAT, ${fw.dnat_rules ?? 0} DNAT, ${fw.masquerade_rules ?? 0} masquerade. Addresses seen by peers will not match the addresses configured here.`,
      });
    }

    const external = conns.filter((c) => c.remote_address && !isPrivate(c.remote_address));
    if (external.length) {
      const uniq = [...new Set(external.map((c) => c.remote_address))];
      out.push({
        level: 'info',
        title: `Open connections to ${uniq.length} address${uniq.length === 1 ? '' : 'es'} outside private ranges`,
        detail: `${uniq.slice(0, 4).join(', ')}${uniq.length > 4 ? ` and ${uniq.length - 4} more` : ''}. Worth recognising each one — outbound is where an unexpected dependency or an unwanted agent shows up.`,
      });
    }

    const remoteSessions = (r.sessions ?? []).filter((s) => s.remote);
    if (remoteSessions.length > 1) {
      out.push({
        level: 'info',
        title: `${remoteSessions.length} remote sessions are logged in`,
        detail: `From ${[...new Set(remoteSessions.map((s) => s.from))].join(', ')}. Expected during an incident; less so at three in the morning on a quiet box.`,
      });
    }

    if (!(r.routes ?? []).some((x) => x.default)) {
      out.push({
        level: 'warn',
        title: 'No default route',
        detail:
          'This host has no path to anything outside its directly connected networks. Deliberate on an isolated segment, and a fault everywhere else.',
      });
    }

    const stale = (r.neighbors ?? []).filter((n) => n.state === 'FAILED' || n.state === 'INCOMPLETE');
    if (stale.length) {
      out.push({
        level: 'info',
        title: `${stale.length} neighbour${stale.length === 1 ? '' : 's'} did not resolve`,
        detail: `${stale.map((n) => n.address).join(', ')} are in the ARP table but never answered. Usually a device that has gone away; occasionally a duplicate address.`,
      });
    }

    if (!out.length) {
      out.push({
        level: 'good',
        title: 'Nothing stands out',
        detail:
          'No sensitive services on every interface, no forwarding, no unexplained outbound connections. The tables above are still worth a read.',
      });
    }

    const list = $('observations');
    if (list) {
      list.innerHTML = out
        .map(
          (o) =>
            `<li class="is-${o.level}"><div><strong>${esc(o.title)}</strong>${esc(o.detail)}</div></li>`,
        )
        .join('');
    }
  }

  function renderCapabilities(r: Report) {
    const caps = r.capabilities ?? {};
    const box = $('caps');
    if (box) {
      box.innerHTML = Object.entries(caps)
        .map(
          ([k, v]) =>
            `<span class="cap is-${v ? 'on' : 'off'}">${v ? '✓' : '○'} ${esc(k)}${
              v ? '' : ' not available'
            }</span>`,
        )
        .join('');
    }

    const notes = $('notes');
    const panel = $('cap-panel');
    const list = r.notes ?? [];
    if (notes) notes.innerHTML = list.map((n) => `<li>${esc(n)}</li>`).join('');
    if (panel) panel.hidden = !Object.keys(caps).length && !list.length;
  }

  // ------------------------------------------------------------------- load

  function render(r: Report) {
    renderHost(r);
    renderMap(r);
    renderExposure(r);
    renderReach(r);
    renderTables(r);
    renderObservations(r);
    renderCapabilities(r);

    const h = r.host ?? {};
    const exposed = (r.listeners ?? []).filter((l) => l.scope === 'all-interfaces');
    summaryText = [
      `Network Lens — ${h.hostname ?? 'host'} (${h.os ?? ''})`,
      `Taken ${r.netlens?.generated ?? ''}${r.netlens?.redacted ? ' (redacted)' : ''}`,
      '',
      `Interfaces: ${(r.interfaces ?? []).length}`,
      `Listening on every interface: ${exposed.map((l) => `${l.port}/${l.protocol}`).join(', ') || 'none'}`,
      `Established connections: ${(r.connections ?? []).length}`,
      `Default route: ${(r.routes ?? []).find((x) => x.default)?.via ?? 'none'}`,
      '',
      ...(r.notes ?? []).map((n) => `Note: ${n}`),
    ].join('\n');

    if (results) results.hidden = false;
  }

  function load(text: string, source: string) {
    let parsed: Report;
    try {
      parsed = JSON.parse(text);
    } catch (error) {
      if (results) results.hidden = true;
      setStatus(
        `That is not valid JSON — ${error instanceof Error ? error.message : error}. Paste the whole file, including the opening brace.`,
        'error',
      );
      return;
    }

    if (!parsed || typeof parsed !== 'object' || !parsed.netlens) {
      if (results) results.hidden = true;
      setStatus(
        'That is JSON, but not a Network Lens report — it has no "netlens" section. Run netlens.sh to produce one.',
        'error',
      );
      return;
    }

    render(parsed);
    setStatus(
      `Read ${source} — collector version ${parsed.netlens.version ?? '?'}${
        parsed.capabilities?.root ? '' : ', run without root'
      }. Nothing was uploaded.`,
      'ok',
    );
  }

  fileInput?.addEventListener('change', async () => {
    const file = fileInput.files?.[0];
    if (!file) return;
    load(await file.text(), file.name);
    fileInput.value = '';
  });

  for (const type of ['dragenter', 'dragover']) {
    drop?.addEventListener(type, (e) => {
      e.preventDefault();
      drop.classList.add('is-over');
    });
  }
  for (const type of ['dragleave', 'drop']) {
    drop?.addEventListener(type, () => drop.classList.remove('is-over'));
  }
  drop?.addEventListener('drop', async (event) => {
    event.preventDefault();
    const file = (event as DragEvent).dataTransfer?.files?.[0];
    if (file) load(await file.text(), file.name);
  });

  let pasteTimer: number | undefined;
  pasteBox?.addEventListener('input', () => {
    window.clearTimeout(pasteTimer);
    const text = pasteBox.value.trim();
    if (!text) {
      if (results) results.hidden = true;
      setStatus('');
      return;
    }
    // Debounced, because a long report arrives one chunk at a time on paste.
    pasteTimer = window.setTimeout(() => load(text, 'pasted report'), 200);
  });

  // Platform switcher. Remembers the choice so a returning visitor is not
  // shown Linux commands on a Windows machine every time.
  const platforms = Array.from(document.querySelectorAll<HTMLButtonElement>('.platform'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-panel]'));

  function showPlatform(id: string) {
    for (const b of platforms) {
      const on = b.dataset.platform === id;
      b.classList.toggle('is-active', on);
      b.setAttribute('aria-selected', on ? 'true' : 'false');
    }
    for (const p of panels) p.hidden = p.dataset.panel !== id;
    try {
      localStorage.setItem('netlens-platform', id);
    } catch {
      /* private mode — the choice simply will not persist */
    }
  }

  platforms.forEach((b) => b.addEventListener('click', () => showPlatform(b.dataset.platform ?? 'linux')));

  let preferred = '';
  try {
    preferred = localStorage.getItem('netlens-platform') ?? '';
  } catch {
    /* ignore */
  }
  if (!preferred) {
    const ua = navigator.userAgent;
    preferred = /Win/i.test(ua) ? 'windows' : 'linux';
  }
  if (platforms.some((b) => b.dataset.platform === preferred)) showPlatform(preferred);

  document.querySelectorAll<HTMLButtonElement>('.cmd__copy').forEach((button) => {
    button.addEventListener('click', async () => {
      const original = button.textContent;
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        button.textContent = 'copied';
      } catch {
        button.textContent = 'failed';
      }
      setTimeout(() => {
        button.textContent = original;
      }, 1400);
    });
  });

  $('copy-summary')?.addEventListener('click', async (event) => {
    const button = event.currentTarget as HTMLButtonElement;
    const original = button.textContent;
    try {
      await navigator.clipboard.writeText(summaryText);
      button.textContent = 'Copied ✓';
    } catch {
      button.textContent = 'Copy failed';
    }
    setTimeout(() => {
      button.textContent = original;
    }, 1600);
  });

  $('clear-btn')?.addEventListener('click', () => {
    if (pasteBox) pasteBox.value = '';
    if (fileInput) fileInput.value = '';
    if (results) results.hidden = true;
    setStatus('');
  });

  $('sample-btn')?.addEventListener('click', () => {
    if (pasteBox) pasteBox.value = '';
    load(JSON.stringify(SAMPLE), 'sample report');
  });

  /** A plausible web server, so the page can be understood before running anything. */
  const SAMPLE = {
    netlens: { version: '1.0', generated: new Date().toISOString().replace(/\.\d+Z$/, 'Z'), redacted: false },
    host: {
      hostname: 'web-prod-01',
      fqdn: 'web-prod-01.internal',
      os: 'Ubuntu 24.04.1 LTS',
      kernel: '6.8.0-45-generic',
      arch: 'x86_64',
      virtualisation: 'kvm',
      uptime_seconds: 1943520,
    },
    capabilities: { root: true, ip: true, ss: true, netstat: true, nft: true, iptables: false, conntrack: false, lsof: true, ps: true, who: true },
    interfaces: [
      { name: 'lo', state: 'UNKNOWN', mtu: 65536, mac: '00:00:00:00:00:00', flags: 'LOOPBACK,UP', addresses: [{ address: '127.0.0.1', prefix: 8, family: 'inet', scope: 'host' }] },
      { name: 'eth0', state: 'UP', mtu: 1500, mac: '06:1f:22:4c:8a:01', flags: 'BROADCAST,MULTICAST,UP', addresses: [{ address: '10.20.10.15', prefix: 24, family: 'inet', scope: 'global' }] },
      { name: 'docker0', state: 'DOWN', mtu: 1500, mac: '02:42:9a:11:be:44', flags: 'BROADCAST,MULTICAST', addresses: [{ address: '172.17.0.1', prefix: 16, family: 'inet', scope: 'global' }] },
    ],
    routes: [
      { destination: 'default', via: '10.20.10.1', device: 'eth0', protocol: 'static', metric: 100, default: true },

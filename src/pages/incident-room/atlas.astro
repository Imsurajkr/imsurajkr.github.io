---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { atlas, domains } from '../../data/incident';
import '../../styles/incident.css';

const description =
  'Concise references for the commands that matter during an incident — ss, lsof, strace, tcpdump, dig, openssl, ps, find, journalctl, curl, nc, vmstat and kubectl — with the invocations worth remembering and the mistake each one invites.';
---

<BaseLayout title="Command Atlas" description={description}>
  <div class="ir">
    <section class="ir-hero">
      <div class="wrap">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/incident-room">Incident Room</a>
          <span aria-hidden="true">/</span>
          <span>Atlas</span>
        </nav>
        <p class="ir-status">Reference · {atlas.length} commands</p>
        <h1 class="ir-title ir-title--sm">Command Atlas</h1>
        <p class="ir-sub">
          Not manual pages — the handful of invocations of each tool that are actually worth
          remembering, and the mistake each one invites when you are moving quickly.
        </p>

        <div class="ir-search">
          <div class="ir-search__field">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="11" cy="11" r="7"></circle>
              <path d="m20 20-3.5-3.5"></path>
            </svg>
            <label class="visually-hidden" for="q">Search commands</label>
            <input id="q" type="search" autocomplete="off" spellcheck="false" placeholder="Search — “deleted”, “backlog”, “thread”, “chain”…" />
            <kbd class="ir-kbd">/</kbd>
          </div>
          <div class="ir-filters" role="group" aria-label="Filter by domain">
            <button type="button" class="ir-filter is-active" data-domain="*">All</button>
            {domains.map((d) => <button type="button" class="ir-filter" data-domain={d}>{d}</button>)}
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <div class="ir-atlas" id="atlas">
          {
            atlas.map((entry) => (
              <article
                class="ir-entry"
                data-domain={entry.domain}
                data-search={`${entry.name} ${entry.purpose} ${entry.uses.map((u) => u.cmd + ' ' + u.note).join(' ')} ${entry.gotcha ?? ''}`.toLowerCase()}
              >
                <div class="ir-entry__head">
                  <h2 class="ir-entry__name">{entry.name}</h2>
                  <span class="chip">{entry.domain}</span>
                </div>
                <p class="ir-entry__purpose">{entry.purpose}</p>

                <div class="ir-uses">
                  {entry.uses.map((use) => (
                    <div>
                      <div class="ir-cmd">
                        <span class="ir-cmd__prompt">$</span>
                        <span class="ir-cmd__text">{use.cmd}</span>
                        <button type="button" class="ir-cmd__copy" data-copy={use.cmd}>
                          copy
                        </button>
                      </div>
                      <p class="ir-use__note">{use.note}</p>
                    </div>
                  ))}
                </div>

                {entry.gotcha && (
                  <p class="ir-gotcha">
                    <strong>Watch out.</strong> {entry.gotcha}
                  </p>
                )}
              </article>
            ))
          }
        </div>
        <p class="ir-empty" id="empty" hidden>Nothing matches that.</p>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const search = document.getElementById('q') as HTMLInputElement | null;
  const empty = document.getElementById('empty');
  const entries = Array.from(document.querySelectorAll<HTMLElement>('.ir-entry'));
  const filters = Array.from(document.querySelectorAll<HTMLButtonElement>('.ir-filter'));
  let domain = '*';

  function apply() {
    const terms = (search?.value ?? '').trim().toLowerCase().split(/\s+/).filter(Boolean);
    let visible = 0;

    for (const entry of entries) {
      const haystack = entry.dataset.search ?? '';
      const show =
        (domain === '*' || entry.dataset.domain === domain) &&
        terms.every((t) => haystack.includes(t));
      entry.hidden = !show;
      if (show) visible++;
    }

    if (empty) empty.hidden = visible > 0;
  }

  search?.addEventListener('input', apply);

  filters.forEach((button) => {
    button.addEventListener('click', () => {
      domain = button.dataset.domain ?? '*';
      filters.forEach((b) => b.classList.toggle('is-active', b === button));
      apply();
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
    button.addEventListener('click', async () => {
      const original = button.textContent;
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        button.textContent = 'copied';
      } catch {
        button.textContent = 'failed';
      }
      setTimeout(() => {
        button.textContent = original;
      }, 1400);
    });
  });

  document.addEventListener('keydown', (event) => {
    const target = event.target as HTMLElement | null;
    if (event.key === '/' && target?.tagName !== 'INPUT') {
      event.preventDefault();
      search?.focus();
      search?.select();
    }
    if (event.key === 'Escape' && target === search && search) {
      search.value = '';
      apply();
      search.blur();
    }
  });
</script>

<style>
  .crumbs {
    display: flex;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--fg-4);
    margin-bottom: 1rem;
  }

  .crumbs a {
    color: var(--fg-3);
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--guard);
  }

  .ir-title--sm {
    font-size: clamp(1.7rem, 1.2rem + 2.2vw, 2.7rem);
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../data/site';
import { certifications, certsNote, profile } from '../data/resume';

const title = 'About';
const description =
  'About Suraj Kumar — Platform Engineer in Gurugram, India. Seven years running Kubernetes, Terraform and CI/CD across AWS, Azure and GCP, currently for regulated banking workloads at Kotak Mahindra Bank.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'About Suraj Kumar',
  url: `${site.url}/about`,
  description,
  mainEntity: {
    '@type': 'Person',
    name: site.author.name,
    jobTitle: profile.headline,
    url: site.url,
    sameAs: [site.social.github, site.social.linkedin],
  },
};

const caresAbout = [
  'Systems that fail gracefully — not systems that never fail.',
  'Documentation that actually gets read — not Confluence graveyards.',
  'On-call rotations that don’t burn people out.',
];

const timeline = [
  { year: '2020', text: 'B.Tech in Computer Science Engineering, JECRC University, Jaipur.' },
  { year: '2020', text: 'First DevOps role at RoboMQ — Docker, GCP and AWS EKS.' },
  {
    year: '2020–2024',
    text: 'Lead DevOps Engineer at FiftyFive Technologies. Multi-cloud platforms, Terraform, Kubeflow, and leading a team of 4 across concurrent client engagements.',
  },
  {
    year: '2024–now',
    text: 'DevOps Engineer 2 at Kotak Mahindra Bank — Kong, Istio, blue-green delivery and CVE visibility for regulated banking workloads.',
  },
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <PageHeader
    eyebrow="About"
    title="About Suraj Kumar"
    lead="Platform Engineer in Gurugram, India. Seven years in. Still learning."
  />

  <section class="section">
    <div class="wrap about">
      <div class="about__main">
        <div class="content prose">
          <p>
            I started as a MEAN stack intern at <strong>RoboMQ</strong> in 2020. The first real
            production system I built was a log management tool with RabbitMQ. I didn't know what
            backpressure was until the queue filled up and crashed. That's how you learn.
          </p>
          <p>
            Since then I've been a DevOps engineer, a lead, and the guy everyone pings when kubectl
            starts acting weird. I've worked across <strong>AWS</strong>, <strong>Azure</strong> and
            <strong>GCP</strong> — sometimes all three in the same week. I don't think multi-cloud is
            a good idea for most companies, but if your client insists on it, you make it work.
          </p>
          <p>
            These days I'm at <strong>Kotak Mahindra Bank</strong>, running Kong and Istio for
            banking workloads, where a bad release is an audit finding as well as an outage. I write
            about the things I break and fix on the <a href="/blog">blog</a>, and the
            <a href="/tools">tools section</a> is the practical side of that: small, browser-only
            utilities I got tired of looking up.
          </p>
          <p>
            I'm not a "thought leader." I don't write threads on X. I fix broken deployments and make
            sure the next person who touches my code doesn't hate me.
          </p>
        </div>

        <h2 class="about__h2">I care about</h2>
        <ul class="cares">
          {caresAbout.map((item) => <li>{item}</li>)}
        </ul>

        <h2 class="about__h2">The short version</h2>
        <ol class="mini-timeline">
          {
            timeline.map((t) => (
              <li>
                <span class="mini-timeline__year">{t.year}</span>
                <span class="muted">{t.text}</span>
              </li>
            ))
          }
        </ol>
      </div>

      <aside class="about__side">
        <div class="panel side-card">
          <h2 class="side-card__title">At a glance</h2>
          <dl class="facts">
            <div><dt>Role</dt><dd>{profile.headline}</dd></div>
            <div><dt>Based in</dt><dd>{site.author.location}</dd></div>
            <div><dt>Experience</dt><dd>7 years</dd></div>
            <div><dt>Every day</dt><dd>Kubernetes · Terraform · Python · AWS</dd></div>
          </dl>
        </div>

        <div class="panel side-card">
          <h2 class="side-card__title">Certifications</h2>
          <p class="muted side-card__body">{certsNote}</p>
          <ul class="chips side-card__certs">
            {
              certifications.map((c) => (
                <li class="chip" title={`${c.name} — ${c.issuer}`}>
                  {c.short}
                </li>
              ))
            }
          </ul>
        </div>

        <div class="panel side-card">
          <h2 class="side-card__title">Hire me</h2>
          <p class="muted side-card__body">
            I'm currently open to senior platform and SRE roles. If you're building infrastructure
            that other engineers ship on, I want to talk.
          </p>
          <a class="btn btn--primary side-card__cta" href="/contact">Get in touch</a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 20rem);
    gap: 2.5rem;
    align-items: start;
  }

  .about__h2 {
    font-size: var(--step-2);
    margin: 3rem 0 1.25rem;
  }

  .cares {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: var(--maxw-prose);
  }

  .cares li {
    position: relative;
    padding-left: 1.1rem;
    font-size: 0.98rem;
    line-height: 1.65;
    color: var(--fg-2);
  }

  .cares li + li {
    margin-top: 0.55rem;
  }

  .cares li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.68em;
    width: 0.45rem;
    height: 1px;
    background: var(--signal);
  }

  .mini-timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .mini-timeline li {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 1rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.93rem;
  }

  .mini-timeline li:last-child {
    border-bottom: 0;
  }

  .mini-timeline__year {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--signal);
  }

  .about__side {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: sticky;
    top: 5.5rem;
  }

  .side-card__title {
    font-size: 0.8rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg-3);
    margin-bottom: 0.9rem;
  }

  .facts {
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .facts > div {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 0.75rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.86rem;
  }

  .facts > div:last-child {
    border-bottom: 0;
  }

  .facts dt {
    color: var(--fg-3);
  }

  .facts dd {
    margin: 0;
  }

  .side-card__certs {
    margin-top: 0.9rem;
  }

  .side-card__body {
    font-size: 0.88rem;
  }

  .side-card__cta {
    margin-top: 1rem;
    width: 100%;
    justify-content: center;
  }

  @media (max-width: 58rem) {
    .about {
      grid-template-columns: 1fr;
    }
    .about__side {
      position: static;
    }
  }

  @media (max-width: 34rem) {
    .mini-timeline li {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }
</style>

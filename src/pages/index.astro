---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ImpactReadout from '../components/ImpactReadout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import CaseStudy from '../components/CaseStudy.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { site } from '../data/site';
import {
  certifications,
  certsNote,
  education,
  engagements,
  experience,
  projects,
  skills,
  skillsOpinion,
} from '../data/resume';
import { tools } from '../data/tools';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const toolCount = tools.length;

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.author.name,
  jobTitle: 'Platform Engineer',
  email: site.author.email,
  telephone: site.author.phone,
  url: site.url,
  image: new URL(site.author.image, site.url).href,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Gurugram',
    addressRegion: 'Haryana',
    addressCountry: 'IN',
  },
  sameAs: [site.social.github, site.social.linkedin],
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'JECRC University, Jaipur' },
  worksFor: { '@type': 'Organization', name: 'Kotak Mahindra Bank' },
  knowsAbout: [
    'Kubernetes',
    'Terraform',
    'AWS',
    'Google Cloud Platform',
    'Microsoft Azure',
    'DevSecOps',
    'Site Reliability Engineering',
    'CI/CD',
    'Platform Engineering',
    'Istio',
    'Kong API Gateway',
  ],
  hasCredential: certifications.map((c) => ({
    '@type': 'EducationalOccupationalCredential',
    name: c.name,
    credentialCategory: 'certification',
    recognizedBy: { '@type': 'Organization', name: c.issuer },
  })),
};

/**
 * Names the site as an entity in its own right. Without this, Google infers a
 * name for the sitelinks block from the title tag, which is the long form.
 */
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.shortTitle,
  alternateName: 'surajkr.dev',
  url: site.url,
  description: site.description,
  inLanguage: 'en',
  author: { '@type': 'Person', name: site.author.name, url: site.url },
};
---

<BaseLayout jsonLd={[personJsonLd, websiteJsonLd]}>
  <Hero />
  <ImpactReadout />

  <!-- 01 — Selected work -->
  <section class="section section--alt" id="work">
    <div class="wrap railed">
      <div class="rail" aria-hidden="true"></div>
      <div>
        <SectionHeader
          index="01"
          label="Work"
          title="Selected work"
          summary="Three projects. Real details. No template."
        />

        <div class="work">
          {projects.map((project, index) => <CaseStudy project={project} index={index} />)}
        </div>
      </div>
    </div>
  </section>

  <!-- 02 — Experience -->
  <section class="section" id="experience">
    <div class="wrap railed">
      <div class="rail" aria-hidden="true"></div>
      <div>
        <SectionHeader index="02" label="Career" title="Experience" />

        <ol class="timeline">
          {
            experience.map((role) => (
              <li class="tl__item" data-reveal>
                <div class="tl__spine" aria-hidden="true">
                  <span class:list={['tl__dot', { 'is-current': role.current }]} />
                </div>

                <article class="tl__role row-hover">
                  <header class="tl__head">
                    <div>
                      <h3 class="tl__title">{role.title}</h3>
                      <p class="tl__company">
                        {role.company}
                        {role.location && <span class="dim"> · {role.location}</span>}
                      </p>
                    </div>

                    <p class="tl__dates">
                      <span>{role.start} — {role.end}</span>
                      {role.current && (
                        <span class="chip chip--health">
                          <span class="status-dot" aria-hidden="true" /> current
                        </span>
                      )}
                    </p>
                  </header>

                  <ul class="points">
                    {role.highlights.map((point) => (
                      <li>{point}</li>
                    ))}
                  </ul>
                </article>
              </li>
            ))
          }
        </ol>

        <div class="engagements" data-reveal>
          <h3 class="sub-title">Client engagements</h3>
          <div class="engagements__grid">
            {
              engagements.map((item) => (
                <article class="panel row-hover">
                  <header class="eng__head">
                    <h4 class="eng__client">{item.client}</h4>
                    <span class="chip">{item.duration}</span>
                  </header>
                  <p class="muted eng__summary">{item.summary}</p>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 — Tech -->
  <section class="section section--alt" id="depth">
    <div class="wrap railed">
      <div class="rail" aria-hidden="true"></div>
      <div>
        <SectionHeader index="03" label="Tech" title="Tech I actually use" />

        <div class="depth">
          {
            skills.map((group) => (
              <section class="depth__group" data-reveal>
                <h3 class="depth__name">{group.label}</h3>
                <ul class="chips">
                  {group.items.map((item) => (
                    <li class="chip">{item}</li>
                  ))}
                </ul>
              </section>
            ))
          }
        </div>

        <p class="opinion" data-reveal>{skillsOpinion}</p>

        <div class="credentials" data-reveal>
          <div class="panel">
            <h3 class="sub-title">Tools I built</h3>
            <p class="muted tools-copy">
              {toolCount} browser-based utilities for DevOps tasks. No backend, no tracking, no AI.
              Just working code — a visual subnet calculator, a PCAP analyzer, a JWT decoder and the
              rest.
            </p>
            <a class="btn" href="/tools">Open the tools →</a>
          </div>

          <div class="panel">
            <h3 class="sub-title">Certifications &amp; education</h3>
            <p class="muted certs-note">{certsNote}</p>
            <ul class="chips certs-chips">
              {
                certifications.map((cert) => (
                  <li class="chip" title={`${cert.name} — ${cert.issuer}`}>
                    {cert.short}
                  </li>
                ))
              }
            </ul>
            {
              education.map((item) => (
                <p class="muted edu-line">
                  {item.degree} — {item.school}, {item.year}.
                </p>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 — Writing -->
  {
    posts.length > 0 && (
      <section class="section" id="writing">
        <div class="wrap railed">
          <div class="rail" aria-hidden="true" />
          <div>
            <SectionHeader
              index="04"
              label="Writing"
              title="Things I wrote down"
              summary="Mostly so I would stop looking them up again."
            />

            <ul class="writing">
              {posts.map((post) => (
                <li data-reveal>
                  <a class="wr row-hover" href={`/blog/${post.id}`}>
                    <FormattedDate date={post.data.pubDate} class="wr__date" />
                    <div class="wr__body">
                      <h3 class="wr__title">{post.data.title}</h3>
                      {post.data.description && (
                        <p class="wr__desc">{post.data.description}</p>
                      )}
                    </div>
                    <span class="wr__go" aria-hidden="true">
                      →
                    </span>
                  </a>
                </li>
              ))}
            </ul>

            <a class="btn writing__all" href="/blog">
              All posts
            </a>
          </div>
        </div>
      </section>
    )
  }

  <!-- 05 — Contact -->
  <section class="section section--alt" id="contact">
    <div class="wrap railed">
      <div class="rail" aria-hidden="true"></div>
      <div>
        <SectionHeader index="05" label="Contact" title="Contact" />

        <div class="contact" data-reveal>
          <div class="contact__copy">
            <p class="lead prose">
              I'm currently open to senior platform and SRE roles. If you're building infrastructure
              that other engineers ship on, I want to talk.
            </p>
            <div class="contact__actions">
              <a class="btn btn--primary" href={site.social.email}>Email me</a>
              <a class="btn" href="/contact">All contact options</a>
            </div>
          </div>

          <dl class="contact__list">
            <div>
              <dt>Email</dt>
              <dd><a href={site.social.email}>{site.author.email}</a></dd>
            </div>
            <div>
              <dt>Phone</dt>
              <dd>
                <a href={`tel:${site.author.phone.replace(/[^+\d]/g, '')}`}>{site.author.phone}</a>
              </dd>
            </div>
            <div><dt>Location</dt><dd>{site.author.location}</dd></div>
            <div>
              <dt>LinkedIn</dt>
              <dd>
                <a href={site.social.linkedin} target="_blank" rel="noopener noreferrer">
                  /in/dev-surajkumar
                </a>
              </dd>
            </div>
            <div>
              <dt>GitHub</dt>
              <dd>
                <a href={site.social.github} target="_blank" rel="noopener noreferrer">@imsurajkr</a>
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Translucent so the particle field reads through the banded sections.
     Cards inside stay fully opaque — body text needs the contrast. */
  .section--alt {
    background: color-mix(in srgb, var(--bg-1) 86%, transparent);
    border-block: 1px solid var(--line);
  }

  .sub-title {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fg-4);
    margin-bottom: var(--s-4);
  }

  .points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    font-size: var(--step--1);
    line-height: 1.6;
    color: var(--fg-2);
  }

  .points li {
    position: relative;
    padding-left: var(--s-4);
  }

  /* Square tick rather than a bullet — schematic, not editorial. */
  .points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 4px;
    height: 4px;
    background: var(--line-3);
  }


  /* -------------------------------------------------------- timeline --- */

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }

  .tl__item {
    display: grid;
    grid-template-columns: 1.25rem minmax(0, 1fr);
    gap: var(--s-4);
  }

  .tl__spine {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 1.4rem;
  }

  .tl__dot {
    width: 9px;
    height: 9px;
    flex: none;
    background: var(--bg);
    border: 1px solid var(--line-3);
    transform: rotate(45deg);
  }

  .tl__dot.is-current {
    background: var(--health);
    border-color: var(--health);
  }

  .tl__spine::after {
    content: '';
    flex: 1;
    width: 1px;
    background: var(--line);
    margin-top: var(--s-2);
  }

  .tl__item:last-child .tl__spine::after {
    display: none;
  }

  .tl__role {
    background: var(--bg-1);
    border: 1px solid var(--line);
    border-radius: var(--r);
    padding: var(--s-5);
  }

  .tl__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--s-4);
    flex-wrap: wrap;
    margin-bottom: var(--s-3);
  }

  .tl__title {
    font-size: var(--step-1);
  }

  .tl__company {
    margin-top: 0.15rem;
    font-size: var(--step--1);
    font-weight: 550;
    color: var(--signal);
  }

  .tl__dates {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--fg-3);
    white-space: nowrap;
  }

  .tl__dates .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .engagements {
    margin-top: var(--s-6);
  }

  .engagements__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: var(--s-3);
  }

  .eng__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
  }

  .eng__client {
    font-size: var(--step-1);
  }

  .eng__summary {
    margin-top: var(--s-2);
    font-size: var(--step--1);
    line-height: 1.6;
  }

  /* ----------------------------------------------------------- depth --- */

  .depth {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--s-5) var(--s-6);
  }

  .depth__name {
    font-size: var(--step--1);
    font-weight: 550;
    padding-bottom: var(--s-2);
    margin-bottom: var(--s-3);
    border-bottom: 1px solid var(--line);
  }

  /* One line, set apart. It is the only opinion in the section. */
  .opinion {
    margin-top: var(--s-6);
    padding-left: var(--s-4);
    border-left: 2px solid var(--signal);
    font-size: var(--step-0);
    line-height: 1.6;
    color: var(--fg-2);
    max-width: var(--maxw-prose);
  }

  .credentials {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: var(--s-3);
    margin-top: var(--s-6);
  }

  .certs-note {
    font-size: var(--step--1);
    line-height: 1.6;
    margin-top: var(--s-3);
  }

  .certs-chips {
    margin-top: var(--s-4);
  }

  .edu-line {
    margin-top: var(--s-4);
    padding-top: var(--s-4);
    border-top: 1px solid var(--line);
    font-size: var(--step--1);
    line-height: 1.6;
  }

  .tools-copy {
    font-size: var(--step--1);
    line-height: 1.6;
    margin-bottom: var(--s-4);
  }

  /* --------------------------------------------------------- writing --- */

  .writing {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .wr {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr) 1.5rem;
    gap: var(--s-4);
    align-items: baseline;
    padding: var(--s-4) var(--s-3);
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    color: inherit;
  }

  .wr__date {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--fg-4);
  }

  .wr__title {
    font-size: var(--step-1);
    line-height: 1.3;
    transition: color 0.16s var(--ease);
  }

  .wr:hover .wr__title {
    color: var(--signal);
  }

  .wr__desc {
    margin-top: var(--s-2);
    font-size: var(--step--1);
    line-height: 1.55;
    color: var(--fg-3);
    max-width: 68ch;
  }

  .wr__go {
    font-family: var(--font-mono);
    color: var(--fg-4);
    transition: transform 0.2s var(--ease), color 0.16s var(--ease);
  }

  .wr:hover .wr__go {
    color: var(--signal);
    transform: translateX(3px);
  }

  .writing__all {
    margin-top: var(--s-5);
  }

  /* --------------------------------------------------------- contact --- */

  .contact {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 21rem), 1fr));
    gap: var(--s-6);
    align-items: start;
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-top: var(--s-5);
  }

  .contact__list {
    margin: 0;
    border-top: 1px solid var(--line);
  }

  .contact__list > div {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    gap: var(--s-4);
    padding: var(--s-3) 0;
    border-bottom: 1px solid var(--line);
    font-size: var(--step--1);
  }

  .contact__list dt {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-4);
  }

  .contact__list dd {
    margin: 0;
    word-break: break-word;
  }

  .contact__list a {
    text-decoration: none;
  }

  .contact__list a:hover {
    text-decoration: underline;
  }

  @media (max-width: 40rem) {
    .tl__item {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    .tl__spine {
      display: none;
    }

    .wr {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-2);
    }

    .wr__go {
      display: none;
    }

    .contact__list > div {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.15rem;
    }
  }
</style>

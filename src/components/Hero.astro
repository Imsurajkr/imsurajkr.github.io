---
import { site } from '../data/site';
import { profile } from '../data/resume';
---

<section class="hero">
  <!-- Two low-opacity glows for colour depth. The texture now comes from the
       page-level particle field behind this section. -->
  <div class="hero__bg" aria-hidden="true">
    <span class="glow glow--a"></span>
    <span class="glow glow--b"></span>
  </div>

  <div class="wrap hero__inner">
    <div class="hero__copy">
      <h1 class="hero__name" data-reveal>Suraj Kumar</h1>

      <p class="hero__role" data-reveal style="--reveal-delay: 100ms">
        {profile.headline} at Kotak Mahindra Bank
      </p>

      <p class="hero__pitch" data-reveal style="--reveal-delay: 150ms">
        There is no compression algorithm for experience. You can’t learn certain lessons without going through the curve
      </p>

      <ul class="hero__specs" data-reveal style="--reveal-delay: 200ms">
        <li><span class="dim">Every day</span> Kubernetes · Terraform · Python · AWS · Bash</li>
        <li><span class="dim">Regularly</span> Istio · Kong · FastAPI · Azure DevOps</li>
        <li><span class="dim">Learning</span> Go, slowly</li>
      </ul>

      <div class="hero__actions no-print" data-reveal style="--reveal-delay: 250ms">
        <a class="btn btn--primary" href="#work">Selected work</a>
        <a class="btn" href="/tools">Try my DevOps tools</a>
        <a class="btn" href={site.social.email}>Get in touch</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(2rem, 4vw, 3.5rem);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .glow {
    position: absolute;
    width: 34rem;
    height: 34rem;
    border-radius: 50%;
    filter: blur(110px);
    opacity: 0.5;
  }

  /* Emerald = health/status, azure = signal/interaction. The glow uses the
     same semantic pair as the rest of the system rather than random colour. */
  .glow--a {
    top: -14rem;
    left: -10rem;
    background: color-mix(in srgb, var(--health) 26%, transparent);
  }

  .glow--b {
    bottom: -18rem;
    right: -10rem;
    background: color-mix(in srgb, var(--signal) 26%, transparent);
  }

  /* Light theme: the glows would wash the page out, so pull them right back. */
  :global(html[data-theme='light']) .glow {
    opacity: 0.32;
  }

  @media (prefers-color-scheme: light) {
    :global(html:not([data-theme='dark'])) .glow {
      opacity: 0.32;
    }
  }

  /* Single column since the figure was removed. The copy is held to a readable
     measure rather than spanning the full container width. */
  .hero__inner {
    position: relative;
  }

  .hero__copy {
    max-width: 54rem;
  }

  .hero__name {
    font-size: var(--step-5);
    font-weight: 600;
    letter-spacing: -0.035em;
  }

  .hero__role {
    font-size: var(--step-2);
    font-weight: 500;
    color: var(--signal);
    letter-spacing: -0.02em;
    margin-top: var(--s-1);
  }

  .hero__pitch {
    max-width: 46ch;
    margin-top: var(--s-4);
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--fg-2);
  }

  .hero__pitch strong {
    color: var(--fg);
    font-weight: 550;
  }

  .hero__specs {
    list-style: none;
    margin: var(--s-5) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: var(--step--2);
  }

  .hero__specs li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: var(--s-3) 0;
    border-bottom: 1px solid var(--line);
    color: var(--fg-2);
  }

  .hero__specs .dim {
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-4);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-top: var(--s-5);
  }

</style>

---
import FormattedDate from './FormattedDate.astro';

export interface Props {
  href: string;
  title: string;
  description?: string;
  pubDate: Date;
  heroImage?: string;
  tags?: string[];
}

const { href, title, description, pubDate, heroImage, tags = [] } = Astro.props;
---

<article class="pc row-hover">
  <a class="pc__link" href={href}>
    <span class="visually-hidden">Read: {title}</span>
  </a>

  {
    heroImage && (
      <div class="pc__media">
        <img src={heroImage} alt="" loading="lazy" decoding="async" width="640" height="300" />
      </div>
    )
  }

  <div class="pc__body">
    <div class="pc__meta">
      <FormattedDate date={pubDate} />
      {tags[0] && <><span aria-hidden="true">·</span><span>{tags[0]}</span></>}
    </div>

    <h3 class="pc__title">{title}</h3>
    {description && <p class="pc__desc">{description}</p>}

    {
      tags.length > 0 && (
        <ul class="chips pc__tags">
          {tags.slice(0, 3).map((tag) => (
            <li class="chip">{tag}</li>
          ))}
        </ul>
      )
    }
  </div>
</article>

<style>
  .pc {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--bg-1);
    border: 1px solid var(--line);
    border-radius: var(--r);
    overflow: hidden;
  }

  .pc__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .pc__media {
    aspect-ratio: 16 / 7;
    overflow: hidden;
    background: var(--bg-2);
    border-bottom: 1px solid var(--line);
  }

  .pc__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.75);
    transition: filter 0.3s var(--ease);
  }

  .pc:hover .pc__media img {
    filter: saturate(1);
  }

  .pc__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--s-4);
  }

  .pc__meta {
    display: flex;
    gap: var(--s-2);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--fg-4);
  }

  .pc__title {
    font-size: var(--step-1);
    line-height: 1.3;
    margin-top: var(--s-2);
    transition: color 0.16s var(--ease);
  }

  .pc:hover .pc__title {
    color: var(--signal);
  }

  .pc__desc {
    font-size: var(--step--1);
    line-height: 1.55;
    color: var(--fg-2);
    margin-top: var(--s-2);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .pc__tags {
    margin-top: auto;
    padding-top: var(--s-4);
  }
</style>

---
import { footerNav, nav, site } from '../data/site';

const year = new Date().getFullYear();
const built = new Date().toISOString().slice(0, 10);
---

<footer class="footer no-print">
  <div class="wrap">
    <div class="footer__top">
      <div class="footer__brand">
        <p class="footer__name">{site.author.name}</p>
        <p class="footer__role mono-label">{site.tagline} · {site.author.location}</p>
      </div>

      <nav class="footer__cols" aria-label="Footer">
        <div>
          <p class="footer__col-title">Site</p>
          {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        </div>
        <div>
          <p class="footer__col-title">More</p>
          {footerNav.map((item) => <a href={item.href}>{item.label}</a>)}
        </div>
        <div>
          <p class="footer__col-title">Elsewhere</p>
          <a href={site.social.github} target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href={site.social.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a href={site.social.email}>Email</a>
        </div>
      </nav>
    </div>

    <div class="footer__bar">
      <p class="dim">© {year} {site.author.name}</p>
      <p class="dim footer__build">
        <span>Astro · GitHub Pages</span>
        <span class="footer__sep" aria-hidden="true">·</span>
        <span>build {built}</span>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    background: var(--bg-1);
    padding-block: var(--s-7) var(--s-5);
    margin-top: var(--s-8);
  }

  .footer__top {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1.8fr);
    gap: var(--s-6);
  }

  .footer__name {
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .footer__role {
    margin-top: 0.2rem;
    text-transform: none;
    letter-spacing: 0.06em;
  }

  .footer__cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 8rem), 1fr));
    gap: var(--s-5);
  }

  .footer__cols > div {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .footer__col-title {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-4);
    margin-bottom: 0.2rem;
  }

  .footer__cols a {
    font-size: var(--step--1);
    color: var(--fg-2);
    text-decoration: none;
    width: fit-content;
  }

  .footer__cols a:hover {
    color: var(--signal);
  }

  .footer__bar {
    display: flex;
    justify-content: space-between;
    gap: var(--s-4);
    flex-wrap: wrap;
    margin-top: var(--s-7);
    padding-top: var(--s-4);
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .footer__build {
    display: flex;
    gap: var(--s-2);
  }

  @media (max-width: 44rem) {
    .footer__top {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-6);
    }
  }
</style>

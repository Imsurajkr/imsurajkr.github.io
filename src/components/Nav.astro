---
import { nav, site } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="nav no-print">
  <div class="wrap nav__inner">
    <a href="/" class="brand" aria-label={`${site.author.name} — home`}>
      <span class="brand__mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <rect x="3" y="3" width="7" height="7" rx="1" />
          <rect x="14" y="14" width="7" height="7" rx="1" />
          <path d="M10 6.5h4a3.5 3.5 0 0 1 3.5 3.5v4" stroke-linecap="round" />
        </svg>
      </span>
      <span class="brand__text">
        <strong>Suraj Kumar</strong>
        <span class="brand__role">Platform &amp; DevOps</span>
      </span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      {
        nav.map((item, index) => (
          <a href={item.href} class:list={['nav__link', { 'is-active': isActive(item.href) }]}>
            <span class="nav__num" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="nav__actions">
      <a
        class="nav__icon"
        href={site.social.github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true"
          ><path
            d="M12 .5a12 12 0 0 0-3.79 23.4c.6.11.82-.26.82-.58v-2.03c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5.99.1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.34-5.47-5.96 0-1.32.47-2.39 1.24-3.23-.13-.3-.54-1.53.11-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6.01 0c2.29-1.55 3.3-1.23 3.3-1.23.65 1.65.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.23 0 4.63-2.8 5.65-5.48 5.95.43.37.82 1.1.82 2.22v3.29c0 .32.22.7.83.58A12 12 0 0 0 12 .5z"
          ></path></svg
        >
      </a>
      <a
        class="nav__icon"
        href={site.social.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true"
          ><path
            d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM2.4 21.5h5.16V9.06H2.4V21.5zM9.9 9.06h4.94v1.7h.07c.69-1.24 2.37-2.55 4.88-2.55 5.22 0 6.18 3.28 6.18 7.54v5.75h-5.15v-5.1c0-1.22-.02-2.78-1.77-2.78-1.78 0-2.05 1.32-2.05 2.69v5.19H9.9V9.06z"
          ></path></svg
        >
      </a>
      <ThemeToggle />
      <button
        class="nav__burger"
        id="nav-burger"
        type="button"
        aria-label="Toggle navigation"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span></span><span></span>
      </button>
    </div>
  </div>

  <nav class="nav__mobile" id="mobile-nav" aria-label="Mobile" hidden>
    {
      nav.map((item, index) => (
        <a href={item.href} class:list={['nav__link', { 'is-active': isActive(item.href) }]}>
          <span class="nav__num" aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </span>
          {item.label}
        </a>
      ))
    }
  </nav>

  <!-- Scroll progress: a thin instrument reading, not a decoration. -->
  <div class="nav__progress" aria-hidden="true"><span id="scroll-progress"></span></div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: var(--s-5);
    min-height: 3.75rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    text-decoration: none;
    color: var(--fg);
    margin-right: auto;
  }

  .brand__mark {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    flex: none;
    border-radius: var(--r-sm);
    border: 1px solid var(--line-2);
    background: var(--bg-1);
    color: var(--signal);
    transition: border-color 0.18s var(--ease);
  }

  .brand:hover .brand__mark {
    border-color: var(--signal);
  }

  .brand__mark svg {
    width: 1rem;
    height: 1rem;
  }

  .brand__text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .brand__text strong {
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .brand__role {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-4);
  }

  .nav__links {
    display: flex;
    gap: var(--s-1);
  }

  .nav__link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.35rem 0.65rem;
    border-radius: var(--r-sm);
    font-size: 0.86rem;
    font-weight: 450;
    color: var(--fg-2);
    text-decoration: none;
    transition: color 0.16s var(--ease), background 0.16s var(--ease);
  }

  .nav__num {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--fg-4);
    transition: color 0.16s var(--ease);
  }

  .nav__link:hover {
    color: var(--fg);
    background: var(--bg-2);
  }

  .nav__link.is-active {
    color: var(--fg);
    background: var(--bg-2);
  }

  .nav__link.is-active .nav__num {
    color: var(--signal);
  }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: 0.2rem;
  }

  .nav__icon {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--r-sm);
    color: var(--fg-3);
    transition: color 0.16s var(--ease), background 0.16s var(--ease);
  }

  .nav__icon svg {
    width: 1rem;
    height: 1rem;
    fill: currentColor;
  }

  .nav__icon:hover {
    color: var(--signal);
    background: var(--bg-2);
  }

  .nav__burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 2rem;
    height: 2rem;
    padding: 0 0.4rem;
    border-radius: var(--r-sm);
    border: 1px solid var(--line);
    background: var(--bg-1);
    cursor: pointer;
  }

  .nav__burger span {
    display: block;
    height: 1px;
    background: var(--fg-2);
    transition: transform 0.2s var(--ease);
  }

  .nav__burger[aria-expanded='true'] span:nth-child(1) {
    transform: translateY(3px) rotate(45deg);
  }

  .nav__burger[aria-expanded='true'] span:nth-child(2) {
    transform: translateY(-3px) rotate(-45deg);
  }

  .nav__mobile {
    display: none;
    flex-direction: column;
    gap: 0.1rem;
    padding: var(--s-2) 1.25rem var(--s-4);
    border-top: 1px solid var(--line);
  }

  .nav__progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: transparent;
  }

  .nav__progress span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--signal);
    opacity: 0.75;
  }

  @media (max-width: 54rem) {
    .nav__links {
      display: none;
    }
    .nav__burger {
      display: flex;
    }
    .nav__mobile:not([hidden]) {
      display: flex;
    }
    .brand__role {
      display: none;
    }
  }

  @media (max-width: 26rem) {
    .nav__icon {
      display: none;
    }
  }
</style>

<script>
  const burger = document.getElementById('nav-burger');
  const mobile = document.getElementById('mobile-nav');

  burger?.addEventListener('click', () => {
    const open = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', String(!open));
    if (mobile) mobile.hidden = open;
  });

  // Reading progress across the document.
  const progress = document.getElementById('scroll-progress');
  if (progress) {
    let ticking = false;
    const update = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const pct = max > 0 ? (window.scrollY / max) * 100 : 0;
      progress.style.width = `${Math.min(100, Math.max(0, pct))}%`;
      ticking = false;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true }
    );
    update();
  }
</script>

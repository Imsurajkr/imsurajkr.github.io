---
import { site } from '../data/site';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  tags?: string[];
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = site.description,
  image = site.ogImage,
  type = 'website',
  publishedTime,
  tags,
  noindex = false,
  jsonLd,
} = Astro.props;

const pageTitle = title ? `${title} · ${site.shortTitle}` : site.title;

/**
 * The build emits `/about.html`, but the page is served — and listed in the
 * sitemap — as `/about`. Both URLs resolve on GitHub Pages, so the canonical
 * has to name the extensionless one or we hand crawlers two addresses for one
 * page and tell them to prefer the address the sitemap does not mention.
 */
const canonicalPath =
  Astro.url.pathname
    .replace(/\/index\.html$/, '/')
    .replace(/\.html$/, '')
    .replace(/(.+)\/$/, '$1') || '/';
const canonical = new URL(canonicalPath, site.url).href;
const ogImage = new URL(image, site.url).href;
const keywords = [...site.keywords, ...(tags ?? [])].join(', ');
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="keywords" content={keywords} />
<meta name="author" content={site.author.name} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
{!noindex && <meta name="robots" content="index, follow, max-image-preview:large" />}
{
  site.googleSiteVerification && (
    <meta name="google-site-verification" content={site.googleSiteVerification} />
  )
}

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.shortTitle} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={title ?? site.title} />
<meta property="og:locale" content={site.locale} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{tags?.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={site.twitterHandle} />
<meta name="twitter:creator" content={site.twitterHandle} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!--
  Google looks for /favicon.ico at the domain root before anything declared
  here, and falls back to a generic globe in search results when it cannot find
  a usable icon. The .ico is listed first and also exists at the root path; the
  SVG is offered to browsers that prefer it, and the PNGs give Googlebot the
  48-multiple square sizes it documents.
-->
<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
<link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={`${site.shortTitle} — Blog`} href="/rss.xml" />

<meta name="theme-color" content="#0b0f14" media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content="#fbfcfd" media="(prefers-color-scheme: light)" />

{
  jsonLd && (
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(Array.isArray(jsonLd) ? jsonLd : [jsonLd])}
    />
  )
}

<!-- Set the theme before first paint so there is no flash of the wrong theme. -->
<script is:inline>
  (function () {
    try {
      var stored = localStorage.getItem('theme');
      if (stored === 'light' || stored === 'dark') {
        document.documentElement.setAttribute('data-theme', stored);
      }
    } catch (e) {
      /* private mode — fall back to the OS preference */
    }
  })();
</script>

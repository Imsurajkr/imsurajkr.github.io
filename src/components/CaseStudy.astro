---
import type { Project } from '../data/resume';

export interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const num = String(index + 1).padStart(2, '0');
---

<article class="cs marked" id={project.slug} data-reveal>
  <header class="cs__head">
    <span class="cs__num" aria-hidden="true">{num}</span>
    <h3 class="cs__name">{project.name}</h3>
    <p class="cs__context mono-label">{project.context}</p>
  </header>

  <div class="cs__story">
    {project.story.map((para) => <p>{para}</p>)}
  </div>

  <p class="cs__label">What changed</p>
  <ul class="cs__changed">
    {project.changed.map((item) => <li>{item}</li>)}
  </ul>

  {
    project.gotWrong && (
      <aside class="cs__wrong">
        <p class="cs__wrong-label">What I got wrong</p>
        <p>{project.gotWrong}</p>
      </aside>
    )
  }

  <p class="cs__stack"><span class="dim">Stack:</span> {project.stack}</p>
</article>

<style>
  .cs {
    background: var(--bg-1);
    border: 1px solid var(--line);
    border-radius: var(--r);
    padding: clamp(1.35rem, 3vw, 2.25rem);
    transition: border-color 0.2s var(--ease);
  }

  .cs:hover {
    border-color: var(--line-2);
  }

  .cs + .cs {
    margin-top: var(--s-4);
  }

  .cs__head {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    column-gap: var(--s-3);
    margin-bottom: var(--s-5);
  }

  .cs__num {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 600;
    color: var(--fg-4);
  }

  .cs__name {
    font-size: var(--step-2);
    letter-spacing: -0.025em;
  }

  .cs__context {
    grid-column: 2;
    margin-top: var(--s-1);
    color: var(--fg-3);
  }

  .cs__story {
    max-width: 62ch;
  }

  .cs__story p {
    font-size: var(--step-0);
    line-height: 1.7;
    color: var(--fg-2);
  }

  .cs__story p + p {
    margin-top: var(--s-3);
  }

  .cs__label {
    margin-top: var(--s-5);
    margin-bottom: var(--s-3);
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--fg);
  }

  .cs__changed {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 62ch;
  }

  .cs__changed li {
    position: relative;
    padding-left: var(--s-4);
    font-size: var(--step--1);
    line-height: 1.65;
    color: var(--fg-2);
  }

  .cs__changed li + li {
    margin-top: var(--s-2);
  }

  .cs__changed li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.4rem;
    height: 1px;
    background: var(--health);
  }

  /* The mistake gets its own space. Understated on purpose — it is not a brag. */
  .cs__wrong {
    margin-top: var(--s-5);
    padding: var(--s-4);
    max-width: 62ch;
    background: var(--bg-2);
    border-left: 2px solid var(--fg-4);
    border-radius: 0 var(--r-sm) var(--r-sm) 0;
  }

  .cs__wrong p {
    font-size: var(--step--1);
    line-height: 1.65;
    color: var(--fg-2);
  }

  .cs__wrong-label {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fg-3);
    margin-bottom: var(--s-2);
  }

  .cs__stack {
    margin-top: var(--s-5);
    padding-top: var(--s-4);
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.6;
    color: var(--fg-3);
  }
</style>

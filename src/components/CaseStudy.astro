---
import ArchDiagram from './ArchDiagram.astro';
import type { Project } from '../data/resume';

export interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const num = String(index + 1).padStart(2, '0');
---

<article class="cs marked" id={project.slug} data-reveal>
  <header class="cs__head">
    <div class="cs__id">
      <span class="cs__num">{num}</span>
      <span class="cs__context mono-label">{project.context}</span>
    </div>

    <h3 class="cs__name">{project.name}</h3>
    <p class="cs__thesis">{project.thesis}</p>
  </header>

  <div class="cs__body">
    <!-- Left column: the engineering narrative -->
    <div class="cs__narrative">
      <section class="cs__block">
        <h4 class="cs__block-title">Problem</h4>
        <p class="cs__text">{project.problem}</p>
      </section>

      <section class="cs__block">
        <h4 class="cs__block-title">Engineering decisions</h4>
        <ol class="decisions">
          {
            project.decisions.map((decision) => (
              <li class="decision">
                <h5 class="decision__title">{decision.title}</h5>
                <p class="decision__body">{decision.body}</p>
              </li>
            ))
          }
        </ol>
      </section>
    </div>

    <!-- Right column: the system view -->
    <div class="cs__system">
      <section class="cs__block">
        <h4 class="cs__block-title">Architecture</h4>
        <ArchDiagram layers={project.architecture} label={project.name} />
      </section>

      <section class="cs__block">
        <h4 class="cs__block-title">Outcome</h4>
        <dl class="outcomes">
          {
            project.outcomes.map((outcome) => (
              <div class="outcome">
                <dt class="outcome__value">{outcome.value}</dt>
                <dd class="outcome__label">{outcome.label}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section class="cs__block">
        <h4 class="cs__block-title">Stack</h4>
        <ul class="chips">
          {project.stack.map((tech) => <li class="chip">{tech}</li>)}
        </ul>
      </section>
    </div>
  </div>
</article>

<style>
  .cs {
    background: var(--bg-1);
    border: 1px solid var(--line);
    border-radius: var(--r);
    padding: clamp(1.25rem, 3vw, 2rem);
    transition: border-color 0.2s var(--ease);
  }

  .cs:hover {
    border-color: var(--line-2);
  }

  .cs + .cs {
    margin-top: var(--s-4);
  }

  .cs__head {
    padding-bottom: var(--s-5);
    border-bottom: 1px solid var(--line);
  }

  .cs__id {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    margin-bottom: var(--s-3);
  }

  .cs__num {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 600;
    color: var(--fg-4);
    padding-right: var(--s-3);
    border-right: 1px solid var(--line-2);
  }

  .cs__name {
    font-size: var(--step-2);
    letter-spacing: -0.025em;
  }

  .cs__thesis {
    margin-top: var(--s-2);
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--signal);
    max-width: 52ch;
  }

  .cs__body {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    padding-top: var(--s-5);
  }

  .cs__block + .cs__block {
    margin-top: var(--s-5);
  }

  .cs__block-title {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fg-4);
    padding-bottom: var(--s-2);
    margin-bottom: var(--s-3);
    border-bottom: 1px solid var(--line);
  }

  .cs__text {
    font-size: var(--step--1);
    line-height: 1.65;
    color: var(--fg-2);
  }

  .decisions {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: decision;
  }

  .decision {
    counter-increment: decision;
    position: relative;
    padding-left: var(--s-6);
  }

  .decision + .decision {
    margin-top: var(--s-4);
    padding-top: var(--s-4);
    border-top: 1px solid var(--line);
  }

  /* Decisions are numbered like clauses in a design doc. */
  .decision::before {
    content: counter(decision, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 0.1em;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--signal);
    opacity: 0.75;
  }

  .decision + .decision::before {
    top: calc(var(--s-4) + 0.1em);
  }

  .decision__title {
    font-size: var(--step-0);
    font-weight: 550;
    line-height: 1.35;
    color: var(--fg);
  }

  .decision__body {
    margin-top: var(--s-2);
    font-size: var(--step--1);
    line-height: 1.6;
    color: var(--fg-2);
  }

  .outcomes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 7rem), 1fr));
    gap: 1px;
    margin: 0;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    overflow: hidden;
  }

  .outcome {
    background: var(--bg-2);
    padding: var(--s-3);
  }

  .outcome__value {
    font-family: var(--font-mono);
    font-size: var(--step-0);
    font-weight: 600;
    color: var(--health);
    line-height: 1.2;
  }

  .outcome__label {
    margin: var(--s-1) 0 0;
    font-size: 0.72rem;
    line-height: 1.35;
    color: var(--fg-3);
  }

  @media (max-width: 58rem) {
    .cs__body {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
